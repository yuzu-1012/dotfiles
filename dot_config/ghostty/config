# Ghostty Configuration — Enhanced Aesthetics & Custom Shader
font-family = Sarasa Mono Gothic SC
#JetBrainsMono Nerd Font
font-size = 12
font-feature = calt
font-feature = liga

# Window & Aesthetics
title = Ghostty@CachyOS
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-padding-color = background
window-decoration = false
gtk-titlebar = false
resize-overlay = never

# Scrollbar, Scrollback & Mouse
scrollbar = system
scrollback-limit = 10000
mouse-hide-while-typing = true
cursor-click-to-move = true

# Cursor & Animation
cursor-style = bar
cursor-style-blink = true
custom-shader = shaders/cursor.frag

# Copy & Paste Keybindings (Smart Ctrl+C: selection -> copy, no selection -> cancel task / SIGINT)
copy-on-select = true
keybind = ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+0=reset_font_size
keybind = ctrl+shift+d=new_split:down
keybind = ctrl+shift+r=new_split:right
keybind = ctrl+shift+u=new_split:up
keybind = ctrl+shift+l=new_split:left
keybind = ctrl+shift+w=close_surface


# Morandi Theme generated by morandi-gen.py
config-file = theme